# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO PARA COOLIFY / ORACLE CLOUD ALWAYS FREE
# ==============================================================================
# Copia y pega este bloque íntegro en Coolify -> Project -> Environment Variables
# (Coolify admite pegado masivo en formato Key=Value)
# ==============================================================================

# 1. Base del Sistema & Dominio Canónico Oficial
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://soyindi.cl
BETTER_AUTH_URL=https://soyindi.cl

# 2. Seguridad & Better-Auth
BETTER_AUTH_SECRET=

# 3. Base de Datos Serverless (Turso SQLite / LibSQL)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 4. Almacenamiento Multimedia S3-Compatible (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# 5. Rate Limiting Distribuido (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 6. Pasarelas de Pago Oficiales (Chile / LatAm)
FLOW_ENV=production
FLOW_API_KEY=
FLOW_SECRET_KEY=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# 7. Autenticación Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 8. Motores de Inferencia IA Multimodal
NVIDIA_API_KEY=
GROQ_API_KEY=

# 9. Administración
ADMIN_EMAILS=
